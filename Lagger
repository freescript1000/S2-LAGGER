    btn.AutoButtonColor = false
    btn.BackgroundColor3 = UI_CONFIG.ButtonInact
    btn.BorderSizePixel = 1
    btn.BorderColor3 = UI_CONFIG.BorderColor
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    return btn
end

